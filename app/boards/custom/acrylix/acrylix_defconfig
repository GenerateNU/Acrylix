# Default Kconfig for plaitpilot (STM32F446RET6 custom PCB)
# Clock speed is NOT set here — STM32 HAL derives it from the RCC node in the board DTS.
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_CLOCK_CONTROL=y
CONFIG_SYS_CLOCK_EXISTS=y
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_GPIO=y
