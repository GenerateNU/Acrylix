#include <zephyr/dt-bindings/gpio/gpio.h>

/* Minimal overlay for smoke test — display/SPI/encoder disabled until MCU is confirmed running */

/* Use internal HSI (16 MHz) instead of HSE — avoids hanging if ST-LINK MCO is not running */
&clk_hse {
    status = "disabled";
};

&pll {
    /* Switch PLL input from HSE to HSI */
    clocks = <&clk_hsi>;
    div-m = <16>;
    mul-n = <192>;
    div-p = <2>;
    div-q = <4>;
    status = "okay";
};

/ {
    aliases {
        led0 = &user_led;
    };

    leds {
        compatible = "gpio-leds";
        user_led: led_0 {
            gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
            label = "User LED";
        };
    };
};

&gpiob {
    status = "okay";
};
